{
  "name": "vektr-design-system",
  "type": "module",
  "version": "2.0.1",
  "description": "Official design tokens, React components, and multi-theme presets for Vektr Design System",
  "main": "./dist/js/index.cjs",
  "module": "./dist/js/index.js",
  "types": "./dist/js/index.d.ts",
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/js/index.d.ts",
        "default": "./dist/js/index.js"
      },
      "require": {
        "types": "./dist/js/index.d.cts",
        "default": "./dist/js/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./icons": {
      "import": {
        "types": "./dist/icons/index.d.ts",
        "default": "./dist/icons/index.js"
      },
      "require": {
        "types": "./dist/icons/index.d.cts",
        "default": "./dist/icons/index.cjs"
      }
    },
    "./css": "./dist/styles.css",
    "./css/theme": "./dist/css/theme.css",
    "./reset.css": "./dist/reset.css",
    "./json": "./dist/json/tokens.json",
    "./typography": "./dist/json/typography.json",
    "./tailwind": {
      "types": "./dist/tailwind/preset.d.cts",
      "default": "./dist/tailwind/preset.cjs"
    },
    "./registry": "./dist/r/registry.json",
    "./r/*": "./dist/r/*.json"
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react/index.d.ts"
      ],
      "icons": [
        "./dist/icons/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build:registry": "node scripts/build-registry.mjs",
    "build": "node build-tokens.mjs && node scripts/build-registry.mjs && tsup && npm test",
    "test:contract": "node scripts/test-token-contract.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:contract && npm run test:unit",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "design-tokens",
    "figma",
    "react-components",
    "ui-library",
    "css-variables",
    "tailwind"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nuel0/vektr-design-system.git"
  },
  "homepage": "https://github.com/Nuel0/vektr-design-system#readme",
  "license": "MIT",
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "style-dictionary": "^4.4.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8",
    "vitest-axe": "^0.1.0"
  }
}
