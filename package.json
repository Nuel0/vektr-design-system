{
  "name": "vektr-design-system",
  "type": "module",
  "version": "1.0.0",
  "description": "Official design tokens and multi-theme presets for Vektr Design System",
  "main": "./dist/js/index.cjs",
  "module": "./dist/js/index.js",
  "types": "./dist/js/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/js/index.d.ts",
      "import": "./dist/js/index.js",
      "require": "./dist/js/index.cjs"
    },
    "./css": "./dist/css/variables.css",
    "./json": "./dist/json/tokens.json",
    "./tailwind": "./dist/tailwind/preset.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build-tokens.mjs"
  },
  "keywords": [
    "design-tokens",
    "figma",
    "style-dictionary",
    "css-variables",
    "tailwind"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "style-dictionary": "^4.4.0"
  }
}
