{
  "name": "vektr-design-system",
  "type": "module",
  "version": "1.1.0",
  "description": "Official design tokens, React components, and multi-theme presets for Vektr Design System",
  "main": "./dist/js/index.cjs",
  "module": "./dist/js/index.js",
  "types": "./dist/js/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/js/index.d.ts",
      "import": "./dist/js/index.js",
      "require": "./dist/js/index.cjs"
    },
    "./react": {
      "types": "./dist/react/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./css": "./dist/css/variables.css",
    "./json": "./dist/json/tokens.json",
    "./typography": "./dist/json/typography.json",
    "./tailwind": "./dist/tailwind/preset.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build-tokens.mjs && tsup && tsc --emitDeclarationOnly"
  },
  "keywords": [
    "design-tokens",
    "figma",
    "react-components",
    "ui-library",
    "css-variables",
    "tailwind"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "style-dictionary": "^4.4.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0"
  }
}
